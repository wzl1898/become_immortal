# ============ LLM 配置 ============
# 协议：openai 或 anthropic
#  - openai   : /v1/chat/completions（DeepSeek / 通义 / Kimi / 本地 vLLM / 兼容网关）
#  - anthropic: /v1/messages（Anthropic 官方或兼容 Anthropic 协议的网关）
LLM_PROTOCOL=openai

# 服务地址（不带末尾 /chat/completions 或 /messages）
LLM_BASE_URL=https://api.deepseek.com/v1
# API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型名
LLM_MODEL=deepseek-chat

# 采样温度（叙事建议 0.8~1.0）
LLM_TEMPERATURE=0.9
# 单次回复最大 token（anthropic 协议必填，openai 也会带上）
LLM_MAX_TOKENS=2048

# 可选：导演使用单独的快速模型；未设置的字段继承上面的主模型配置。
# DIRECTOR_LLM_PROTOCOL=openai
# DIRECTOR_LLM_BASE_URL=https://api.deepseek.com/v1
# DIRECTOR_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# DIRECTOR_LLM_MODEL=deepseek-chat
# 三个导演 Agent 的结构化输出上限；事件与爽点并行，随后调用节奏 Agent。
DIRECTOR_EVENT_MAX_TOKENS=350
DIRECTOR_PAYOFF_MAX_TOKENS=450
DIRECTOR_PACING_MAX_TOKENS=450
DIRECTOR_LLM_TIMEOUT=35

# 仅 anthropic 协议用到，一般无需改
# ANTHROPIC_VERSION=2023-06-01

# ---- 示例：OpenAI 协议（DeepSeek）----
# LLM_PROTOCOL=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 示例：Anthropic 协议 ----
# LLM_PROTOCOL=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-5
